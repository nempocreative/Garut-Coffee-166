{
  "expo": {
    "name": "Kopi Garut",
    "slug": "kopi-garut-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
      "splash": {
        "backgroundColor": "#F6F0E8",
        "image": "./assets/images/icon.png",
        "resizeMode": "contain"
      },
    "scheme": "kopi-garut-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
