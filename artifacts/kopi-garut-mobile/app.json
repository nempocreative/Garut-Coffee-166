{
  "expo": {
    "name": "Garut Beans",
    "slug": "kopi-garut-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kopi-garut-logo.png",
    "scheme": "kopi-garut-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/kopi-garut-logo.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F0E8",
          "image": "./assets/images/kopi-garut-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Garut Beans membutuhkan akses foto untuk menyimpan bukti pemeriksaan mutu.",
          "cameraPermission": "Garut Beans membutuhkan akses kamera untuk memotret kondisi biji kopi."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
